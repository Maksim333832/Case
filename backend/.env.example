# App
APP_NAME=AI Security Workflow
DATABASE_URL=sqlite:///./data/workflow.db
UPLOADS_DIR=./data/uploads
ARTIFACTS_DIR=./data/runs
RUNS_DIR=/tmp/runs
KEEP_FAILED_RUN_WORKSPACES=0
NODE_TIMEOUT_SECONDS=120

# Security & Secrets (set strong key in prod; auto-generated outside repo if omitted)
# APP_SECRET_KEY=

# Scanners (NEVER enable stubs in production/demo!)
USE_STUB_SCANNERS=0
VULN_DB_PATH=./data/vulnerabilities.json
# SCANNER_SECRETS_IMPL=
# SCANNER_SCA_IMPL=
# SCANNER_SAST_IMPL=

# Git allowlist (comma-separated or JSON array)
GIT_CLONE_ALLOWLIST=["https://github.com/TBagirov/training"]

# LLM (OpenAI-compatible: Gemini / OpenAI / Ollama / vLLM)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Ollama local example:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=ollama

# Optional CI/CD protection token
# CI_API_TOKEN=
